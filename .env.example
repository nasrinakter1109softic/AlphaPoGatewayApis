NODE_ENV=development
PORT=3000
SEED_EXTRA_DATA=true

# PostgreSQL database configuration
DB_HOST=db_host
DB_PORT=db_port
DB_USER=postgres_user
DB_PASS=postgres_password
DB_NAME=db_name
DATABASE_URL=db_url

# AlphaPo API configuration
ALPHAPO_API_KEY=alphapo_api_key
ALPHAPO_SECRET_KEY=alphapo_secret_key
ALPHAPO_BASE_URL=alphapo_base_url

# AWS S3 configuration
S3_BUCKET=s3_bucket_name
S3_ACCESS_KEY=s3_access_key
S3_SECRET_KEY=s3_secret_key
S3_REGION=s3_region
# JWT configuration
JWT_SECRET=jwt_secret_key
JWT_EXPIRES_IN=jwt_expires_in
JWT_REFRESH_SECRET=jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=jwt_refresh_expires_in

# Redis configuration
REDIS_HOST=redis_host
REDIS_PORT=redis_port
REDIS_PASS=redis_password

# Mail configuration
MAIL_MAILER=mail_mailer
MAIL_HOST=mail_host
MAIL_PORT=mail_port
MAIL_ENCRYPTION=mail_encryption
MAIL_USERNAME=mail_username
MAIL_PASSWORD=mail_password
MAIL_FROM_ADDRESS=mail_from_address
APP_NAME=app_name
MAIL_FROM_NAME="${APP_NAME}"


# Alpha SMS configuration
ALPHA_SMS_URL=alpha_sms_url
ALPHA_SMS_API_KEY=alpha_sms_api_key

#Super Admin Login info
 SA_EMAIL =sa_email
 SA_PASSWORD = sa_password
